async function
  _contract_address_auto_detect() {
  const
    _contract_address =
      _get(
        "contract",
        "address");
  const
    _target_app =
      _get(
        "target",
        "app");
  const
    _target_network =
      _get(
        "target",
        "network");
  const
    _target_contract =
      _get(
        "target",
        "contract");
  if ( _contract_address != "" ) {
    const
      _address_valid =
        await _address_check(
          _contract_address);
    if ( ! _address_valid ) {
      if ( _target_app != "" &&
           _target_network != "" &&
           _target_contract != "" ) {
        _msg =
          "Looking for address " +
          "corresponding to contract " +
          `'${_target_contract}' for the ` +
          `'${_target_app}' ` +
          "libEVM application on network " +
          `'${_target_network}'.`;
        _msg_info(
          _msg);
        _evm_contract_deployment_address_args = [
          [ _target_network ],       // target networks
          [ _target_network ],       // target chain ids
          "n",                       // all networks
          _target_app,
          _contract,
          "",                        // contract version
          "n",                       // user-level
          "",                        // configuration format
          _deployments_dir
        ];
        _contract_address =
          await _evm_contract_deployment_address.apply(
            null,
            _evm_contract_deployment_address_args);
      }
      else {
        _msg =
          "One between the " +
          `application '${_target_app}', ` +
          `the network '${_target_network}' ` +
          `or the contract '${_target_contract}' ` +
          `has not been specified.`;
        _msg_info(
          _msg);
      }
    }
  }
  _set(
    "contract",
    "address",
    _contract_address);
}

