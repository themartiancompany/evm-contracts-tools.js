    _target_networks_set =
      Object.keys(
        _target_networks_index);
  _msg =
    "Auto-detecting address " +
    `for contract '${_contract_address}' ` +
    `on network '${_target_networks_set}' ` +
    `for application '${_target_app}'.`;
  _msg_info(
    _msg);
  if ( _contract_address != "" ) {
    const
      _address_valid =
        await _address_check(
          _contract_address);
    if ( _address_valid ) {
      _msg =
        `Address '${_contract_address}' ` +
        `is valid.`;
      _msg_info(
        _msg);
    }
    else {
      if ( _target_app != "" &&
           0 < _target_networks.length &&
           _target_contract != "" ) {
        _msg =
          "Looking for address " +
          "corresponding to contract " +
          `'${_target_contract}' for the ` +
          `'${_target_app}' ` +
          "libEVM application on network " +
          `'${_target_networks}' at deployments ` +
          `directory '${_deployments_dir}'.`;
        _msg_info(
          _msg);
        _evm_contract_deployment_address_args = [
          _target_networks_set,      // target networks
          _target_networks_set,      // target chain ids
          "n",                       // all networks
          _target_app,
          _target_contract,
          "",                        // contract version
          "n",                       // user-level
          "",                        // configuration format
          _deployments_dir
        ];
        try {
          _contract_addresses =
            await _evm_contract_deployment_address.apply(
              null,
              _evm_contract_deployment_address_args);
          _contract_address =
            _contract_addresses[
              0];
        }
        catch(
          _error) {
          _msg =
            "Error while looking for contract " +
            "address from local libEVM applications " +
            "deployments directories.";
          _msg_error(
            _msg,
            0);
          _msg_error(
            _error,
            0);
          throw _error;
        }
      }
      else {
        _msg =
          "One between the " +
          `application '${_target_app}', ` +
          `the network '${_target_networks_set}' ` +
          `or the contract '${_target_contract}' ` +
          `has not been specified.`;
        _msg_info(
          _msg);
      }
    }
  }
  _set(
    "contract",
    "address",
    _contract_address);
}

function
  _data_dir_auto_detect() {
  const
    _homedir =
      _homedir_get();
  const
    _app_name =
      _get(
        "app",
        "name");
  const
    _data_dir =
      _path_join([
        _homedir,
        ".local",
        "share",
        _app_name
      ]);
  _override_set(
    "data",
    "dir",
    _data_dir);
}

function
  _cache_dir_auto_detect() {
