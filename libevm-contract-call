function
  _contract_abi_get(
    _network,
    _address,
    _api_key,
    _compiler_output,
    _abi) {
  let
    _abi_target;
  const
    _abi_type =
      typeof(
        _abi);
  if ( _abi_type == "undefined" ) {
    _abi =
      _get(
        "contract",
        "abi");
  }
  const
    _network_type =
      typeof(
        _network);
  if ( _network_type == "undefined" ) {
    _network =
      _get(
        "target",
        "network");
  }
  const
    _address_type =
      typeof(
        _address);
  if ( _address_type == "undefined" ) {
    _address =
      _get(
        "contract",
        "address");
  }
  const
    _api_key_type =
      typeof(
        _api_key);
  if ( _api_key_type == "undefined" ) {
    _api_key =
      _get(
        "api",
        "key");
  }
  const
    _compiler_output_type =
      typeof(
        _compiler_output);
  if ( _compiler_output_type == "undefined" ) {
    _compiler_output =
      _get(
        "contract",
        "compiler_output");
  }
  _abi_target =
    _abi;
  if ( typeof(
         _abi_target) === "undefined" ||
       _abi_target === "" ) {
    _abi_target =
      _default_artifact_path_get(
        "abi");
  }
  const
    _abi_dir =
      _dirname(
        _abi);
  if ( ! _file_exists(
           _abi) &&
       ! _file_exists(
           _compiler_output) ) {
    if ( _file_exists(
           _abi_target) ) {
      _abi =
        _abi_target;
    }
    else {
      _contract_artifacts_retrieve(
        _abi_dir);
    }
  }
  return _abi;
}

