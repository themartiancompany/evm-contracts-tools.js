async function
  _evm_contract_call(
    _call_type,
    _call_timeout,
    _wallet_name,
    _wallet_path,
    _wallet_password,
    _wallet_seed,
    _api_key,
    _msg_value,
    _price_gas,
    _measure_unit,
    _retries_max,
    _target_networks,
    _rpc_selection,
    _contract_address,
    _contract_abi,
    _contract_bytecode,
    _contract_compiler_output,
    _contract_method,
    _method_args,
    _output_file) {
  let
    _contract,
    _contract_run_args,
    _contracts,
    _msg,
    _method,
    _methods,
    _network,
    _out,
    _receipt,
    _static_call_args,
    _tx,
    _value;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  _contracts =
    {};
  _methods =
    {};
  _target_networks =
    _target_networks_check(
      _target_networks);
  _contracts =
    _contracts_init(
      _contracts,
      _target_networks);
  _methods =
    _methods_init(
      _methods,
      _target_networks);
  _out =
    [];
  _call_type =
    _call_type_check(
      _call_type);
  // const
  //   _rpc =
  //     await =
  //       _rpc_get.apply(
  //         null,
  //         _rpc_get_args);
  // _out.push(
  //   _call_type);
  // return _out;
  // _msg =
  //   "Running EVM network call " +
  //   `of type '${_call_type}'.`;
  // _msg_info(
  //   _msg);
  if ( _call_type == "static" ) {
    for ( _network of _target_networks ) {
      _method =
        _methods[
          _network];
      _static_call_args = [
        _wallet_seed,
        _retries_max,
        _api_key,
        _network,
        _contract_abi,
        _contract_bytecode,
        _contract_compiler_output,
        _method,
        _contract_address,
        _contract_method,
        _method_args
      ];
      _msg =
        "Performing static call " +
        `on network '${_network}' ` +
        "with arguments:";
      _msg_info(
        _msg);
      if ( _quiet == "n" ) {
        _echo(
          _static_call_args);
      }
      [ _value,
        _method ] =
        await _contract_call_static.apply(
          null,
          _static_call_args);
      _out.push(
        _value);
    }
  }
  else if ( _call_type == "dynamic" ) {
    for ( _network of _target_networks ) {
      _method =
        _methods[
          _network];
      _contract =
        _contracts[
          _network];
      _contract_run_args = [
        _retries_max,
        _call_timeout,
        _wallet_seed,
        _wallet_password,
        _api_key,
        _price_gas,
        _msg_value,
        _measure_unit,
        _network,
        _contract_address,
        _contract_abi,
        _contract_bytecode,
        _contract_compiler_output,
        _contract_method,
        _method_args,
        _output_file,
        _quiet,
        _contract,
        _method
      ];
      [ _tx,
        _receipt,
        _method,
        _contract ] =
        await _contract_run.apply(
          null,
          _contract_run_args);
      _out.push([
        _tx,
        _receipt
      ]);
    }
    _out =
      await _contract_run.apply(
        null,
        _contract_run_args);
  }
  return _out;
}

function
  _artifact_type_check(
    _artifact_type) {
  let
    _flag_empty,
    _flag_wrong,
    _msg_empty,
    _msg_wrong;
  _flag_empty =
    false;
  _flag_wrong =
    false;
  const
    _artifact_type_type =
      typeof(
        _artifact_type);
  if ( _artifact_type_type === "undefined" ) {
    _msg_empty =
      "Artifact type undefined.";
    _flag_empty =
      true;
  }
  else if ( _artifact_type_type === "string" ) {
    if ( _artifact_type_type.length < 1 ) {
    _msg_empty =
      "Artifact type not set.";
    _flag_empty =
      true;
    }
    else {
      if ( _artifact_type !== "abi" &&
           _artifact_type !== "bytecode" &&
           _artifact_type !== "compiler_output" ) {
        _msg_wrong =
          "Artifact type can be 'abi', " +
          "'bytecode' or 'compiler_output'.";
        _flag_wrong =
          true;
      }
    }
  }
  else {
    _msg_wrong =
      "Artifact type must be of type string.";
    _flag_wrong =
      true;
  }
  if ( _flag_empty ) {
    _msg_error(
      _msg_empty,
      0);
    throw _msg_empty;
  }
  if ( _flag_wrong ) {
    _msg_error(
      _msg_wrong,
      0);
    throw _msg_wrong;
  }
  return _artifact_type;
}

function
  _artifact_local_auto_detect(
    _artifact_type) {
  let
    _msg;
  try {
    _artifact_type =
      _artifact_type_check(
        _artifact_type);
  }
  catch(
    _error) {
    _msg =
      "Error checking artifact type.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _artifact =
      _default_artifact_path_get(
        _artifact_type);
  if ( _artifact_type == "abi" ) {
    _override_set(
      "contract",
      "abi",
      _artifact);
  }
  else if ( _artifact_type == "bytecode" ) {
    _override_set(
      "contract",
      "bytecode",
      _artifact);
  }
  else if ( _artifact_type == "compiler_output" ) {
    _override_set(
      "contract",
      "compiler_output",
      _artifact);
  }
}

async function
  _target_app_get(
    _contract_address) {
  let
    _target_app;
  _target_app =
    "";
  const
    _contract_address_type =
      typeof(
        _contract_address);
  if ( _contract_address_type != "undefined" &&
       _contract_address != "" ) {
    const
      _address_valid =
        _address_check(
          _contract_address);
    if ( ! _address_valid ) {
      _target_app =
        await _app_lookup_contract(
          _contract_address);
    }
  }
  return _target_app;
}

async function
  _contract_lookup_address(
    _target_app,
    _address,
    _target_network) {
  let
    _contract,
    _contract_address,
    _contract_dir,
    _contract_networks,
    _evm_contract_deployment_address_args,
    _exception,
    _msg,
    _network;
  const
    _target_contracts =
      {};
  const
    _lib =
      await _lib_get();
  const
    _deployments_dir =
      _path_join([
        _lib,
        _target_app,
        "deployments"
      ]);
  const
    _contracts =
      await _ls(
        _deployments_dir);
  for ( _contract of _contracts ) {
    _contract_dir =
      _path_join([
        _deployments_dir,
        _contract
      ]);
    _contract_networks =
      await _ls(
        _contract_dir);
    for ( _network in _contract_networks ) {
      _evm_contract_deployment_address_args = [
        [ _target_network ],       // target networks
        [ _target_network ],       // target chain ids
        "n",                       // all networks
        _target_app,
        _contract,
        "",                        // contract version
        "n",                       // user-level
        "",                        // configuration format
        _deployments_dir
      ];
      _contract_address =
        await _evm_contract_deployment_address.apply(
          null,
          _evm_contract_deployment_address_args);
      if ( _address == _contract_address ) {
        if ( _target_network == "" ) {
          _target_contracts[
            _contract] =
            1;
        }
        else {
          if ( _network == _target_network ) {
            _target_contracts[
              _contract] =
              1;
          }
	}
      }
    }
  }
  const
    _target_contracts_set =
      Object.keys(
        _target_contracts);
  const
    _target_contracts_amount =
      _target_contracts_set.length; 
  if ( _target_contracts_amount < 1 ) {
    _msg =
      "No contract found for " +
      `address '${_address}' ` +
      `on network '${_network}' in '${_lib}'.`;
    _msg_error(
      _msg,
      0);
    _exception = {
      "msg":
        _msg
    };
    throw _exception;
  }
  if ( 1 < _target_contracts_amount ) {
    _msg =
      "Found more than one contract for " +
      `contract '${_contract}' ` +
      `in '${_lib}':\n`;
    for ( _contract of _target_contracts_set ) {
      _msg =
        _msg + `${_contract}\n`;
    }
    _msg_error(
      _msg,
      0);
    _exception = {
      "msg":
        _msg
    };
    throw _exception;
  }
  else {
    return _target_contracts_set;
  }
}

async function
  _app_lookup_contract(
    _contract_name) {
  let
    _app,
    _contract_dir,
    _is_dir,
    _msg;
  const
    _lib =
      await _lib_get();
  const
    _target_apps =
      {};
  const
    _apps =
      await _ls(
      _lib);
  for ( _app of _apps ) {
    _contract_dir =
      _path_join([
        _lib,
        _app,
        "deployments",
        _contract_name
      ]);
    // _echo(_contract_dir);
    _is_dir =
      await _dir_exists(
        _contract_dir);
    // _echo(_is_dir);
    if ( _is_dir ) {
      // _echo(
      //   _contract_dir);
      _target_apps[
        _app] =
        1;
    }
  }
  const
    _target_apps_set =
      Object.keys(
        _target_apps);
  const
    _target_apps_amount =
      _target_apps_set.length;
  if ( _target_apps_amount < 1 ) {
    _msg =
      "No apps found for " +
      `contract '${_contract_name}' ` +
      `in '${_lib}'.`;
    _msg_error(
      _msg,
      0);
    const
      _exception = {
        "msg":
          _msg
      };
    throw _exception;
  }
  else if ( 1 < _target_apps_amount ) {
    _msg =
      "Found more than one app for " +
      `contract '${_contract_name}' ` +
      `in '${_lib}': '${_target_apps_set}'.`;
    _msg_error(
      _msg,
      0);
    const
      _exception = {
        "msg":
          _msg
      };
    throw _exception;
  }
  return _target_apps_set[
    0];
}

async function
  _target_app_auto_detect() {
  let
    _target_app;
  _target_app =
    "";
  const
    _contract_address =
      _get(
        "contract",
        "address");
  const
    _contract_address_type =
      typeof(
        _contract_address);
  if ( _contract_address_type != "undefined" &&
       _contract_address != "" ) {
    _target_app =
      await _target_app_get(
        _contract_address);
  }
  _override_set(
    "target",
    "app",
    _target_app);
}

