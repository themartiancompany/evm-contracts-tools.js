function
  _target_networks_get(
    _target_networks) {
  // TODO:
  //   _evm_wallet_module._balance_discovery
  const
    _target_networks_type =
      typeof(
        _target_networks);
  if ( _target_networks_type == "undefined" ) {
    _target_networks =
      _get(
        "target",
        "networks");
  }
  if ( _target_networks == "" ||
       _target_networks == [] ) {
    // to be auto-detected
    _target_networks = [
        "1"
      ];
  }
  return [ _target_networks,
           _target_network ];
}

function
  _target_networks_auto_detect() {
  // TODO:
  //   _evm_wallet_module._balance_discovery
  let
    _target_network;
    _target_networks;
  _target_networks =
    _get(
      "target",
      "networks");
  [ _target_networks,
    _target_network ] =
    _target_networks_auto_detect(
      _target_networks);
  _set(
    "target",
    "networks",
    _target_networks);
  _override_set(
    "target",
    "network",
    _target_network);
}

function
  _default_artifact_path_get(
    _type) {
  let
    _file_name;
  const
    _home =
      _homedir_get();
  const
    _data_dir =
      _path_join( [
        _home,
        ".local",
        "share",
        "evm-contract-call" ]);
  if ( _type == "abi" ) {
    _file_name =
      `${contract_address}.abi.json`;
  }
  else if ( _type == "bytecode" ) {
    _file_name =
      `${contract_address}.bin`;
  }
  else if ( _type == "compiler_output" ) {
    _file_name =
      `${contract_address}.json`;
  }
  else {
    const
      _msg =
        `Unknown artifact type '${_type}'.`;
    _msg_error(
      _msg,
      1);
  }
  const
    _artifact =
      _path_join( [
        _data_dir,
        target_network,
        _file_name ]);
  return _artifact;
}

function
  _contract_artifacts_retrieve() {
  true;
}

function
  _contract_abi_get(
    _network,
    _address,
    _api_key,
    _compiler_output,
    _abi) {
  let
    _abi_target;
  const
    _abi_type =
      typeof(
        _abi);
  if ( _abi_type == "undefined" ) {
    _abi =
      _get(
        "contract",
        "abi");
  }
  const
    _network_type =
      typeof(
        _network);
  if ( _network_type == "undefined" ) {
    _network =
      _get(
        "target",
        "network");
  }
  const
    _address_type =
      typeof(
        _address);
  if ( _address_type == "undefined" ) {
    _address =
      _get(
        "contract",
        "address");
  }
  const
    _key_type =
      typeof(
        _key);
  if ( _key_type == "undefined" ) {
    _key =
      _get(
        "api",
        "key");
  }
  const
    _compiler_output_type =
      typeof(
        _compiler_output);
  if ( _compiler_output_type == "undefined" ) {
    _compiler_output =
      _get(
        "contract",
        "compiler_output");
  }
  _abi_target =
    _abi;
  if ( typeof(
         _abi_target) == "undefined" ||
       _abi_target == "" ) {
    _abi_target =
      _default_artifact_path_get(
        "abi");
  }
  const
    _abi_dir =
      _dirname(
        _abi);
  if ( ! _file_exists(
           _abi) &&
       ! _file_exists(
           _compiler_output) ) {
    if ( _file_exists(
           _abi_target) ) {
      _abi =
        _abi_target;
    }
    else {
      _contract_artifacts_retrieve(
        _abi_dir);
    }
  }
  return _abi;
}

function
  _contract_abi_auto_detect() {
  let
    _abi;
  const
    _network =
      _get(
        "target",
        "network");
  const
    _address =
      _get(
        "contract",
        "address");
  const
    _key =
      _get(
        "api",
        "key");
  const
    _compiler_output =
      _get(
        "contract",
        "compiler_output");
  _abi =
    _get(
      "contract",
      "abi");
  _abi =
    _contract_abi_get(
      _network,
      _address,
      _api_key,
      _compiler_output,
      _abi);
  _override_set(
    "contract",
    "abi",
    _abi);
}

function
  _call_auth_get(
    _call_type) {
  let
    _call_auth;
  const
    _call_type_type =
      typeof(
        _call_type);
  if ( _call_type_type == "undefined" ) {
    _call_type =
      _get(
        "call",
        "type");
  }
  if ( _call_type == "static" ) {
    _call_auth =
      "n";
  }
  else if ( call_type == "dynamic" ) {
    _call_auth =
      "y";
  }
  else {
    const
      _msg =
        `Unknown call type '${call_type}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _call_auth;
}

function
  _call_auth_auto_detect() {
  const
    _call_type =
      _get(
        "call",
        "type");
  const
    _call_auth =
      _call_auth_get(
        _call_type);
  _override_set(
    "call",
    "type",
    _call_type);
}

async function
  _evm_contract_call(
    _call_type,
    _call_timeout,
    _wallet_name,
    _wallet_path,
    _wallet_password,
    _wallet_seed,
    _api_key,
    _msg_value,
    _price_gas,
    _measure_unit,
    _retries_max,
    _target_networks,
    _rpc_selection,
    _contract_address,
    _contract_abi,
    _contract_bytecode,
    _contract_compiler_output,
    _contract_method,
    _method_args) {
  let
    _explorer,
    _out,
    _result,
    _rpc;
  if ( _call_type == "static" ) {
    const
      _infos =
        [];
    _out =
      "";
  }
  else if ( _call_type == "dynamic" ) {
    _out =
      "";
  }
  else {
    const
      _msg =
        `Unknown call type ` +
        `'${_call_type}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _out;
}

function
  _artifact_local_auto_detect(
    _artifact_type) {
  const
    _artifact =
      _default_artifact_path_get(
        _artifact_type);
  if ( _artifact_type == "abi" ) {
    _override_set(
      "contract",
      "abi",
      _artifact);
  }
  else if ( _artifact_type == "bytecode" ) {
    _override_set(
      "contract",
      "bytecode",
      _artifact);
  }
  else if ( _artifact_type == "compiler_output" ) {
    _override_set(
      "contract",
      "compiler_output",
      _artifact);
  }
}

