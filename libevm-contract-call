async function
  _contract_lookup_address(
    _target_app,
    _address,
    _target_network) {
  let
    _contract,
    _contract_address,
    _contract_dir,
    _contract_networks,
    _evm_contract_deployment_address_args,
    _exception,
    _msg,
    _network;
  const
    _target_contracts =
      {};
  const
    _lib =
      await _lib_get();
  const
    _deployments_dir =
      _path_join([
        _lib,
        _target_app,
        "deployments"
      ]);
  const
    _contracts =
      await _ls(
        _deployments_dir);
  for ( _contract of _contracts ) {
    _contract_dir =
      _path_join([
        _deployments_dir,
        _contract
      ]);
    _contract_networks =
      await _ls(
        _contract_dir);
    for ( _network in _contract_networks ) {
      _evm_contract_deployment_address_args = [
        [ _target_network ],       // target networks
        [ _target_network ],       // target chain ids
        "n",                       // all networks
        _target_app,
        _contract,
        "",                        // contract version
        "n",                       // user-level
        "",                        // configuration format
        _deployments_dir
      ];
      _contract_address =
        await _evm_contract_deployment_address.apply(
          null,
          _evm_contract_deployment_address_args);
      if ( _address == _contract_address ) {
        if ( _target_network == "" ) {
          _target_contracts[
            _contract] =
            1;
        }
        else {
          if ( _network == _target_network ) {
            _target_contracts[
              _contract] =
              1;
          }
	}
      }
    }
  }
  const
    _target_contracts_set =
      Object.keys(
        _target_contracts);
  const
    _target_contracts_amount =
      _target_contracts_set.length; 
  if ( _target_contracts_amount < 1 ) {
    _msg =
      "No contract found for " +
      `address '${_address}' ` +
      `on network '${_network}' in '${_lib}'.`;
    _msg_error(
      _msg,
      0);
    _exception = {
      "msg":
        _msg
    };
    throw _exception;
  }
  if ( 1 < _target_contracts_amount ) {
    _msg =
      "Found more than one contract for " +
      `contract '${_contract}' ` +
      `in '${_lib}':\n`;
    for ( _contract of _target_contracts_set ) {
      _msg =
        _msg + `${_contract}\n`;
    }
    _msg_error(
      _msg,
      0);
    _exception = {
      "msg":
        _msg
    };
    throw _exception;
  }
  else {
    return _target_contracts_set;
  }
}

async function
  _app_lookup_contract(
    _contract_name) {
  let
    _app,
    _contract_dir,
    _is_dir,
    _msg;
  const
    _lib =
      await _lib_get();
  const
    _target_apps =
      {};
  const
    _apps =
      await _ls(
      _lib);
  for ( _app of _apps ) {
    _contract_dir =
      _path_join([
        _lib,
        _app,
        "deployments",
        _contract_name
      ]);
    // _echo(_contract_dir);
    _is_dir =
      await _dir_exists(
        _contract_dir);
    // _echo(_is_dir);
    if ( _is_dir ) {
      // _echo(
      //   _contract_dir);
      _target_apps[
        _app] =
        1;
    }
  }
  const
    _target_apps_set =
      Object.keys(
        _target_apps);
  const
    _target_apps_amount =
      _target_apps_set.length;
  if ( _target_apps_amount < 1 ) {
    _msg =
      "No apps found for " +
      `contract '${_contract_name}' ` +
      `in '${_lib}'.`;
    _msg_error(
      _msg,
      0);
    const
      _exception = {
        "msg":
          _msg
      };
    throw _exception;
  }
  else if ( 1 < _target_apps_amount ) {
    _msg =
      "Found more than one app for " +
      `contract '${_contract_name}' ` +
      `in '${_lib}': '${_target_apps_set}'.`;
    _msg_error(
      _msg,
      0);
    const
      _exception = {
        "msg":
          _msg
      };
    throw _exception;
  }
  return _target_apps_set[
    0];
}

