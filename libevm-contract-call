function
  _call_type_check(
    _call_type) {
  let
    _msg;
  const
    _call_type_type =
      typeof(
        _call_type);
  if ( _call_type_type == "undefined" ) {
    _call_type =
      "static";
  }
  else if ( _call_type_type == "string" ) {
    if ( _call_type.length < 1 ) {
      // To be properly auto-detected.
      _call_type =
        "static";
    }
  }
  else if ( _call_type_type == "object" ||
            _call_type_type == "array" ) {
    _msg =
      "Parameter '_call_type' " +
      "must be of type 'string'";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  else {
    _msg =
      `Call type '${_call_type}' ` +
      `('${_call_type_type}'):`;
    _msg_error(
      _msg,
       0);
    _echo2(
      _call_type);
    throw _msg;
  }
  return _call_type;
}

function
  _contracts_init(
    _contracts,
    _target_networks) {
  let
    _network;
  for ( _network of _target_networks ) {
    if ( ! ( _network in _contracts ) ) {
      _contracts[
        _network] =
        "";
    }
  }
  return _contracts;
}

