function
  _target_networks_get(
    _target_networks) {
  let
    _msg,
    _target_networks_type;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  // TODO:
  //   _evm_wallet_module._balance_discovery
  _target_networks_type =
    typeof(
      _target_networks);
  if ( _target_networks_type === "undefined" ) {
    _target_networks =
      _get(
        "target",
        "networks");
    _msg =
      "Variable '_target_networks' undefined, " +
      `defaulting to value ` +
      `'${_target_networks}' of global variable ` +
      `'target_networks'.`;
    _msg_info(
      _msg);
    _target_networks_type =
      typeof(
        _target_networks);
    if ( _target_networks_type === "undefined" ) {
      _msg =
        "Global variable 'target_networks' undefined, " +
        `defaulting to chain with ID 1.`;
      _msg_info(
        _msg);
      _target_networks = [
        1
      ];
    }
    else if ( _target_networks_type === "string" ) {
      if ( _target_networks.length < 1 ) {
        _msg =
          "Global variable 'target_networks' undefined, " +
          `defaulting to chain with ID 1.`;
        _msg_info(
          _msg);
        _target_networks = [
          1
        ];
      }
      else {
        _msg =
          `Unknown type '${_target_networks_type}' ` +
          `for variable '_target_networks'.`;
        _msg_error(
          _msg,
          0);
        _echo2(
          _target_networks);
        throw _msg;
      }
    }
  }
  else if ( _target_networks_type === "string" ) {
    if ( _target_networks.length < 1 ) {
      _target_networks =
        _get(
          "target",
          "networks");
      _msg =
        "Variable '_target_networks' undefined, " +
        `defaulting to value ` +
        `'${_target_networks}' of global variable ` +
        `'target_networks'.`;
      _msg_info(
        _msg);
      _target_networks_type =
        typeof(
          _target_networks);
      if ( _target_networks_type === "undefined" ) {
        _msg =
          "Global variable 'target_networks' undefined, " +
          `defaulting to chain with ID 1.`;
        _msg_info(
          _msg);
        _target_networks = [
          1
        ];
      }
    }
    else {
      _msg =
        `Invalid type 'string' ` +
        `for variable '_target_networks' ` +
        `('${_target_networks}').`;
      _msg_error(
        _msg,
        0);
      _echo2(
        _target_networks);
      throw _msg;
    }
  }
  else if ( _target_networks_type === "array" ||
            _target_networks_type === "object" ) {
    _msg =
      "Selecting target networks:";
    _msg_info(
      _msg);
    if ( _quiet == "n" ) {
      _echo(
        _target_networks);
    }
  }
  else {
    _msg =
      "Variable '_target_networks' must be of " +
      "type 'array'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  const
    _target_network =   
      _target_network[0];
  return [ _target_networks,
           _target_network ];
}

