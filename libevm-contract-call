  let
    _network;
  for ( _network of _target_networks ) {
    if ( ! ( _network in _methods ) ) {
      _methods[
        _network] =
        "";
    }
  }
  return _methods;
}

function
  _target_networks_check(
    _target_networks) {
  const
    _target_networks_length =
      _target_networks.length;
  if ( _target_networks.length < 1 ) {
    const
      _msg =
        "Auto-selecting network (chain ID '1').";
    _target_networks.push(
      1);
  }
  return _target_networks;
}

async function
  _evm_contract_call(
    _call_type,
    _call_timeout,
    _wallet_name,
    _wallet_path,
    _wallet_password,
    _wallet_seed,
    _api_key,
    _msg_value,
    _price_gas,
    _measure_unit,
    _retries_max,
    _target_networks,
    _rpc_selection,
    _contract_address,
    _contract_abi,
    _contract_bytecode,
    _contract_compiler_output,
    _contract_method,
    _method_args,
    _output_file) {
  let
    _contracts,
    _msg,
    _methods,
    _method,
    _network,
    _out,
    _value;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  _contracts =
    {};
  _methods =
    {};
  _target_networks =
    _target_networks_check(
      _target_networks);
  _contracts =
    _contracts_init(
      _contracts,
      _target_networks);
  _methods =
    _methods_init(
      _methods,
      _target_networks);
  _out =
    [];
  _call_type =
    _call_type_check(
      _call_type);
  // const
  //   _rpc =
  //     await =
  //       _rpc_get.apply(
  //         null,
  //         _rpc_get_args);
  // _out.push(
  //   _call_type);
  // return _out;
  // _msg =
  //   "Running EVM network call " +
  //   `of type '${_call_type}'.`;
  // _msg_info(
  //   _msg);
  if ( _call_type == "static" ) {
    const
      _static_call_args = [
        _wallet_seed,
        _retries_max,
        _api_key,
        "",
        _contract_abi,
        _contract_bytecode,
        _contract_compiler_output,
        _method,
        _contract_address,
        _contract_method,
        _method_args
      ];
    for ( _network of _target_networks ) {
      _static_call_args[
        4] =
        _network;
      _method =
        _methods[
          _network];
      _static_call_args[
        7] =
        _method;
      [ _value,
        _method ] =
        await _contract_call_static.apply(
          null,
          _static_call_args);
      _out.push(
        _value);
    }
  }
  else if ( _call_type == "dynamic" ) {
    const
      _contract_run_args = [
        _retries_max,
        _call_timeout,
        _wallet_seed,
        _wallet_password,
        _api_key,
        _price_gas,
        _msg_value,
        _measure_unit,
        "network",
        _contract_address,
        _contract_abi,
        _contract_bytecode,
        _contract_compiler_output,
        _contract_method,
        _method_args
        _output_file,
        _quiet
        _contract,
        _method
      ];
    for ( _network of _target_networks ) {
      _contract_run_args[
        8] =
        _network;
      _method =
        _methods[
          _network];
      _contract =
        _contracts[
          _network];
      _contract_run_args[
        17] =
        _contract;
      _contract_run_args[
        18] =
        _method;
      [ _value,
        _method ] =
        await _contract_call_static.apply(
          null,
          _static_call_args);
      _out.push(
        _value);
    }
    _out =
      await _contract_run.apply(
        null,
        _contract_run_args);
  }
  return _out;
}

