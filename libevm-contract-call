function
  _target_networks_get(
    _target_networks) {
  // TODO:
  //   _evm_wallet_module._balance_discovery
  const
    _target_networks_type =
      typeof(
        _target_networks);
  if ( _target_networks_type == "undefined" ) {
    _target_networks =
      _get(
        "target",
        "networks");
  }
  if ( _target_networks == "" ||
       _target_networks == [] ) {
    // to be auto-detected
    _target_networks = [
        "1"
      ];
  }
  const
    _target_network =   
      _target_network[0];
  return [ _target_networks,
           _target_network ];
}

function
  _target_networks_auto_detect() {
  // TODO:
  //   _evm_wallet_module._balance_discovery
  let
    _target_network,
    _target_networks;
  _target_networks =
    _get(
      "target",
      "networks");
  [ _target_networks,
    /* eslint-disable-next-line
         prefer-const */  
    _target_network ] =
    _target_networks_auto_detect(
      _target_networks);
  _set(
    "target",
    "networks",
    _target_networks);
  _override_set(
    "target",
    "network",
    _target_network);
}

function
  _default_artifact_path_get(
    _type) {
  let
    _file_name;
  const
    _home =
      _homedir_get();
  const
    _data_dir =
      _path_join( [
        _home,
        ".local",
        "share",
        "evm-contract-call" ]);
  if ( _type == "abi" ) {
    _file_name =
      `${contract_address}.abi.json`;
  }
  else if ( _type == "bytecode" ) {
    _file_name =
      `${contract_address}.bin`;
  }
  else if ( _type == "compiler_output" ) {
    _file_name =
      `${contract_address}.json`;
  }
  else {
    const
      _msg =
        `Unknown artifact type '${_type}'.`;
    _msg_error(
      _msg,
      1);
  }
  const
    _artifact =
      _path_join( [
        _data_dir,
        target_network,
        _file_name ]);
  return _artifact;
}

