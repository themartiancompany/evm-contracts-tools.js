      _api_key,
      _compiler_output,
      _abi);
  _override_set(
    "contract",
    "abi",
    _abi);
}

function
  _call_auth_get(
    _call_type) {
  let
    _call_auth;
  const
    _call_type_type =
      typeof(
        _call_type);
  if ( _call_type_type == "undefined" ) {
    _call_type =
      _get(
        "call",
        "type");
  }
  if ( _call_type == "static" ) {
    _call_auth =
      "n";
  }
  else if ( call_type == "dynamic" ) {
    _call_auth =
      "y";
  }
  else {
    const
      _msg =
        `Unknown call type '${call_type}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _call_auth;
}

