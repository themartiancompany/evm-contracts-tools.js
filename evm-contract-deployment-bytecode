function
  _global_variables() {
  /* global
       app_name:
         writable */
  app_name =
    "evm-contract-deployments-bytecode.js";
  /* global
       app_opts:
         writable */
  app_opts =
    [];
  /* global
       runtime_environment:
         writable */
  runtime_environment =
    "";
  /* global
       resolve_date:
         writable */
  resolve_date =
    "";
  /* global
       target_networks:
         writable */
  target_networks =
    [];
  /* global
       network_ids:
         writable */
  network_ids =
    [];
  /* global
       networks_all:
         writable */
  networks_all =
    "";
  /* global
       target_app:
         writable */
  target_app =
    "";
  /* global
       target_contract:
         writable */
  target_contract =
    "";
  /* global
       contract_version:
         writable */
  contract_version =
    "";
  /* global
       user_defined:
