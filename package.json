    "evm-contracts-tools":
      "./evm-contracts-tools",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.88",
    "evm-wallet.js":
      "npm:evm-wallet.js@^0.0.88",
    "libevm":
      "^0.0.37"
  },
  "type":
    "module",
  "main":
    "evm-contracts-tools",
  "bin":
    { 
      "evm-contract-call":
        "evm-contract-call",
      "ethereum-address-validate":
        "lib/address-check",
      "evm-contract-call.js":
        "evm-contract-call",
      "evm-contract-call-dynamic.js":
        "lib/evm-contract-call-dynamic",
      "evm-contract-call-dynamic":
        "lib/evm-contract-call-dynamic",
      "evm-contract-call-static":
        "lib/evm-contract-call-static",
      "evm-contract-call-static.js":
        "lib/evm-contract-call-static",
      "evm-contract-deployment-address":
        "evm-contract-deployment-address",
      "evm-contract-deployment-address.js":
        "evm-contract-deployment-address",
      "evm-contract-deployment-abi":
        "evm-contract-deployment-abi",
      "evm-contract-deployment-abi.js":
        "evm-contract-deployment-abi",
      "evm-contract-deployment-bytecode":
        "evm-contract-deployment-bytecode",
      "evm-contract-deployment-bytecode.js":
        "evm-contract-deployment-bytecode",
      "evm-contract-deployment-compiler-output":
        "evm-contract-deployment-compiler-output",
      "evm-contract-deployment-compiler-output.js":
        "evm-contract-deployment-compiler-output",
      "evm-contract-deployment-networks":
        "evm-contract-deployment-networks",
      "evm-contract-deployment-networks.js":
        "evm-contract-deployment-networks",
      "evm-contract-deployment-versions":
        "evm-contract-deployment-versions",
      "evm-contract-deployment-versions.js":
        "evm-contract-deployment-versions",
      "evm-contract-deployments-dir":
        "evm-contract-deployments-dir",
      "evm-contract-deployments-dir.js":
        "evm-contract-deployments-dir"
    },
  "yargs": {
    "parse-numbers":
      false,
    "parse-positional-numbers":
      false
  },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details; for _app in evm-contract-call evm-contract-deployment-address evm-contract-deployment-abi evm-contract-deployment-bytecode evm-contract-deployment-compiler-output evm-contract-deployment-deployment-networks evm-contract-deployment-versions evm-contract-deployments-dir evm-contracts-tools; do cp 'fs-worker.js' \"dist/${_app}\"; cp 'fs-worker.js' \"dist/lib${_app}\" || true; done",
    "build-libevm-contract-call":
      "npx webpack --mode 'production' --config 'libevm-contract-call.webpack.config.cjs' --stats-error-details && mv -v 'libevm-contract-call.js' 'dist/libevm-contract-call'",
    "build-libevm-contract-deployment-address":
      "_app='libevm-contract-deployment-address'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contract-deployment-abi":
      "_app='libevm-contract-deployment-abi'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contract-deployment-bytecode":
      "_app='libevm-contract-deployment-bytecode'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contract-deployment-compiler-output":
      "_app='libevm-contract-deployment-compiler-output'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
        "build-libevm-contract-deployment-networks":
      "_app='libevm-contract-deployment-networks'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contract-deployment-versions":
      "_app='libevm-contract-deployment-versions'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contract-deployments-dir":
      "_app='libevm-contract-deployments-dir'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-libevm-contracts-tools":
      "true",
    "build-lib":
      "for _app in evm-contract-call evm-contract-deployment-address evm-contract-deployment-abi evm-contract-deployment-bytecode evm-contract-deployment-compiler-output evm-contract-deployment-networks evm-contract-deployment-versions evm-contract-deployments-dir evm-contracts-tools; do npm run \"build-lib${_app}\"; done",
    "build-evm-contract-call":
      "_app='evm-contract-call'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-address":
      "_app='evm-contract-deployment-address'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-abi":
      "_app='evm-contract-deployment-abi'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-bytecode":
      "_app='evm-contract-deployment-bytecode'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-compiler-output":
      "_app='evm-contract-deployment-compiler-output'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployments-dir":
      "_app='evm-contract-deployments-dir'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-networks":
      "_app='evm-contract-deployment-networks'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contract-deployment-versions":
      "_app='evm-contract-deployment-versions'; npx webpack --mode 'production' --config \"${_app}.webpack.config.cjs\" --stats-error-details; mv -v \"${_app}.js\" \"dist/${_app}\"",
    "build-evm-contracts-tools":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details; mv -v 'evm-contracts-tools.js' 'dist/evm-contracts-tools'",
    "build-bin":
      "for _app in evm-contract-call evm-contract-deployment-address evm-contract-deployment-abi evm-contract-deployment-bytecode evm-contract-deployment-compiler-output evm-contract-deployment-networks evm-contract-deployment-versions evm-contract-deployments-dir evm-contracts-tools; do npm run \"build-${_app}\"; done",
    "build-man":
      "make build-man",
    "build":
      "npm run lint; npm run build-fs-worker; npm run build-lib; npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm run build-man && npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/evm-contract-call'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
