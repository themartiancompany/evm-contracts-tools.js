      "^17.3.0",
    "safely-serve":
      "^0.0.19",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^10000000000001.1000000000000001.1000000000000001",
    "ethers":
      "^6.13.2",
    "evm-chains-info":
      "^0.0.34",
    "evm-transactions-tools":
      "^0.0.111111",
