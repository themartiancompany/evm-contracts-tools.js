    _msg =
      "Target contract undefined, auto-detecting.";
    _msg_info(
      _msg);
    _target_contract_get =
      true;
  }
  else if ( _target_contract_type === "string" ) {
    if ( _target_contract.length < 1 ) {
      _msg =
        "Target contract not set, auto-detecting.";
      _msg_info(
        _msg);
      _target_contract_get =
        true;
    }
  }
  else {
    _msg =
      "Target contract must have type 'string'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _target_contract_get ) {
    try {
      const
        _deployments_dir_check_args = [
          _deployments_dir,
          _target_app,
          _user_defined
        ];
      _deployments_dir =
        await _deployments_dir_check(
         _contract_address,
         _deployments_dir,
	 _target_app);
    }
    catch(
      _error) {
      _msg =
        "Error auto-detecting target contract name.";
    }
    try {
      _contract_address =
        await _contract_address_check(
         _contract_address,
         _deployments_dir,
	 _target_app);
    }
    catch(
      _error) {
      _msg =
        "Error auto-detecting target contract name.";
    }
    const
      _address_valid =
        await _address_check(
          _contract_address);
    if ( ! _address_valid ) {
      _target_contract =
        _contract_address;
    }
  }
  return _target_contract;
}

async function
