function
  _user_defined_check(
    _user_defined) {
  let
    _msg;
  const
    _user_defined_type =
      typeof(
        _user_defined);
  if ( _user_defined_type === "undefined" ) {
    _msg =
      "Variable '_user_defined' undefined, " +
      "setting default value 'n'.";
    _msg_info(
      _msg);
    _user_defined =
      "n";
  }
  else if ( _user_defined_type === "string" ) {
    if ( _user_defined.length < 1 ) {
      _msg =
        "Variable '_user_defined' not set, " +
        "setting default value 'n'.";
      _msg_info(
        _msg);
      _user_defined =
        "n";
    }
    else if ( _user_defined.length > 1 ||
              ( _user_defined !== "n" &&
                _user_defined !== "y" ) ) {
      _msg =
        "Variable '_user_defined' can have " +
        "value 'y' or 'n'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      "Variable '_user_defined' must be of type " +
      "string and have value 'y' or 'n'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _user_defined;
}

