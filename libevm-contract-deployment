async function
  _contract_abi_auto_detect(
    _app,
    _contract,
    _networks,
    _address,
    _deployments_dir,
    _user_defined) {
  let
    _abi,
    _abi_retrieve,
    _msg;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  _app =
    _app_check(
      _app,
      false);
  _user_defined =
    _user_defined_check(
      _user_defined);
  const
    _deployments_dir_check_args = [
      _deployments_dir,
      _app,
      _user_defined
    ];
  try {
    _deployments_dir =
      await _deployments_dir_check.apply(
        null,
        _deployments_dir_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_deployments_dir_check'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  const
    _target_contract_check_args = [
      _contract,
      _address,
      _app,
      _deployments_dir
    ];
  try {
    _contract =
      await _target_contract_check(
        _target_contract_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_target_contract_check' " +
      "with parameters:";
    _echo2(
      _target_contract_check_args);
    _echo2(
      _error);
    throw _error;
  }
  const
    _networks =
      _get(
        "target",
        "networks");
  const
    _contract_address_check_args = [
      _address,
      _deployments_dir,
      _app
    ];
  try {
    _address =
      await _contract_address_check.apply(
        null,
        _contract_address_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_contract_address_check' " +
      "with parameters:";
    _echo2(
      _contract_address_check_args);
    _echo2(
      _error);
    throw _error;
  }
  const
    _api_key =
      _get(
        "api",
        "key");
  const
    _compiler_output =
      _get(
        "contract",
        "compiler_output");
  _abi =
    _get(
      "contract",
      "abi");
  const
    _abi_type =
      typeof(
        _abi);
  _abi_retrieve =
    false;
  if ( _abi_type === "undefined" ) {
    _abi_retrieve =
      true;
  }
  else if ( _abi_type === "string" ) {
    if ( _abi.length < 1 ) {
      _abi_retrieve =
        true;
    }
  }
  if ( _abi_retrieve ) {
    if ( 1 < _networks.length ) {
      _msg =
        "You can't currently retrieve " +
        "ABI for more than a contract.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    else if ( 1 == _networks.length ) {
      const
        _network =
          _networks[
            0];
      const
        _contract_abi_get_args = [
          _network,
          _address,
          _api_key,
          _compiler_output,
          _abi,
          _app,
          _contract
        ];
      _msg =
        "Running '_contract_abi_get' with " +
        "parameters:";
      _msg_info(
        _msg);
      if ( _quiet == "n" ) {
        _echo(
          _contract_abi_get_args);
      }
      try {
        _abi =
          await _contract_abi_get.apply(
            null,
            _contract_abi_get_args);
      }
      catch(
        _error) {
        _msg =
          "Error running '_contract_abi_get'.";
        _msg_error(
          _msg,
          0);
        _echo2(
          _error);
        throw _error;
      }
    }
    else {
      _msg =
        "You must currently select a network " +
        "to auto-detect the abi for " +
        "a libevm application contract.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  _override_set(
    "contract",
    "abi",
    _abi);
}



