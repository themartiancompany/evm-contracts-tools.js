function
  _app_check(
    _app,
    _local) {
  let
    _undefined_flag,
    _msg;
  const
    _local_type =
      typeof(
        _local);
  if ( _local_type === "undefined" ) {
    _msg =
      "Local not specified, setting default " +
      "value 'false'.";
    _local =
      true;
  }
  else if ( _local_type !== "boolean" ) {
    _msg =
      "Variable '_local' must be a boolean.";
    _msg_error(
      _msg,
      0);
  }
  const
    _app_type =
      typeof(
        _app);
  if ( _app_type == "undefined" ) {
    _msg =
      "No application specified.";
    _undefined_flag =
      true;
  }
  else if ( _app_type == "string" ) {
    if ( _app.length < 1 ) {
      _msg =
        "No application specified.";
      _undefined_flag =
        true;
    }
  }
  else {
    _msg =
      "Application argument must be of " +
      `type string (current type: '${_app_type}').`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _undefined_flag ) {
    if ( _local ) {
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    else {
      _msg =
        "Local option disabled, " +
