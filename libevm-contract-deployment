      "function.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _evm_contract_deployments_dir_args = [
      _app,
      _user_defined
    ];
  const
    _system_deployments =
      await _evm_contract_deployments_dir.apply(
        null,
        _evm_contract_deployments_dir_args);
