function
  _app_check(
    _app,
    _local) {
  let
    _undefined_flag,
    _msg;
  const
    _local_type =
      typeof(
        _local);
  if ( _local_type === "undefined" ) {
    _msg =
      "Local not specified, setting default " +
      "value 'false'.";
    _local =
      true;
  }
  else if ( _local_type !== "boolean" ) {
    _msg =
      "Variable '_local' must be a boolean.";
    _msg_error(
      _msg,
      0);
  }
  const
    _app_type =
      typeof(
        _app);
  if ( _app_type == "undefined" ) {
    _msg =
      "No application specified.";
    _undefined_flag =
      true;
  }
  if ( _app_type == "string" ) {
    if ( _app.length < 1 ) {
      _msg =
        "No application specified.";
      _undefined_flag =
        true;
    }
  }
  else {
    _msg =
      "Application argument must be of " +
      "type string.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _undefined_flag ) {
    if ( _local ) {
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    else {
      _msg =
        "Local option disabled, " +
        "getting '_app' variable from " +
        "global variable 'target_app'.";
      _msg_info(
        _msg);
      const
        _global =
          _global_get();
      const
        _target_app =
          _get(
            "target",
            "app");
      const
        _target_app_type =
          typeof(
            _target_app);
      if ( _target_app_type === "string" ) {
        if ( 0 < _target_app.length ) {
          _msg =
            "Getting '_app' variable value from " +
            "global variable 'target_app'.";
          _msg_info(
            _msg);
          _app =
            _target_app;
        }
        else {
          _msg =
            "Error while auto-detecting '_app' variable " +
            "value, global variable 'target_app' " +
            "also not set.";
          _msg_error(
            _msg,
            0);
          throw _msg;
        }
      }
      else {
        _msg =
          "Global variable 'target_app' has " +
          "the wrong type for the local " +
          `variable '_app' ('${_target_app_variable}')`;
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
  return _app;
}

async function
  _contract_version_auto_detect() {
  let
    _config,
    _config_ext,
    _deployments,
    _evm_contracts_deployment_versions,
    _found,
    _net,
    _network,
    _network_id,
    _networks,
    _version,
    _msg;
  _networks =
    [];
  const
    _contract =
      target_contract;
  _found =
    false;
  if ( configuration_format == "bash" ) {
    _config_ext =
      "sh";
  }
  else if ( configuration_format == "bash" ) {
    _config_ext =
      "json";
  }
  const
    _contract_type =
      typeof(
        _contract);
  if ( _contract != "" &&
       _contract_type != "undefined" ) {
    const
      _deployments_dir_type =
        typeof(
          deployments_dir);
    if ( _deployments_dir_type != "undefined" &&
         deployments_dir != "" ) {
      _deployments =
        deployments_dir;
      if ( 0 < target_networks.length ) {
        _network =
          target_networks[
            0];
      }
      if ( 0 < network_ids.length ) {
        _network_id =
          _network_ids[
            0];
      }
      const
        _deployments_path =
          _path_join( [
            _deployments,
            _contract ] );
      if ( networks_all == "n" ) {
        _networks.push(
          _network,
          _network_id);
      }
      else if ( networks_all == "y" ) {
        const
          _evm_contract_deployment_networks_args = [
            _deployments_path,
            "y",                  // Display all
            "n",                  // Display safest
            "n"                   // Display cheapest
          ];
        _networks_new =
          await _evm_contract_deployment_networks.apply(
            null,
            _evm_contract_deployment_networks_args);
        _networks =
          _networks.concat(
            _networks_new);
      }
      for ( _net of _networks ) {
        _config =
          _path_join( [
            _deployments_path,
            _net,
            `config.${_config_ext}`
            ]);
        if ( _file_exists(
               _config) ) {
          _found =
            true;
          _msg =
            `Found deployment configuration ` +
            `at location '${_config}'.`;
          _msg_info(
            _msg);
          break;
        }
      }
      if ( ! _found ) {
        _msg =
          "No deployment configuration " +
          "file found for network " +
          `'${_network}' with ID ` +
          `'${_network_id}'.`;
        _msg_error(
          _msg,
          1);
      }
      const
        _libevm_contract_deployment_versions_module =
          await import(
            "./libevm-contract-deployment-versions");
      _evm_contract_deployment_versions =
        _get(
          "_evm_contract",
          "deployment_versions");
      const
        _evm_contract_deployment_versions_type =
          typeof(
            _evm_contract_deployment_versions_dir);
      if ( _evm_contract_deployment_versions_type == "undefined" ||
           _evm_contract_deployment_versions == "" ) {
        const
          _libevm_contract_deployment_versions_module =
            await import(
              "./libevm-contract-deployment-versions");
          _evm_contract_deployment_versions =
            _libevm_contract_deployment_versions_module._evm_contract_deployment_versions;
      }
      const
        _evm_contract_deployment_versions_args = [
          _config,
          "y",                  // display highest
          "n",                  // display lowest
          configuration_format
        ];
      _version =
        await _evm_contract_deployment_versions.apply(
          null,
          _evm_contract_deployment_versions_args);
    }
    else if ( _deployments_dir_type == "undefined" ||
              deployments_dir == "" ) {
      const
        _msg =
          "If no target application is specified " +
          "then the user-defined deployments " +
          "switch must be enabled with '-u' and " +
          "a deployments directory must be specified " +
          "with '-d'.";
      _msg_error(
        _msg,
        1);
    }
  }
  _override_set(
    "contract",
    "version",
    _version);
  return true;
}

