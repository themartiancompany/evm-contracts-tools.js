function
  _configuration_format_check(
    _configuration_format) {
  let
    _msg;
  const
    _configuration_format_type =
      typeof(
        _configuration_format);
  if ( _configuration_format_type === "undefined" ) {
    _msg =
      "Configuration format not set, " +
      "setting default (bash).";
    _msg_info(
      _msg);
    _configuration_format =
      "bash";
  }
  else if ( _configuration_format_type === "string" ) {
    if ( _configuration_format.length < 1 ) {
      _msg =
        "Configuration format not set, " +
        "setting default (bash).";
      _msg_info(
        _msg);
      _configuration_format =
        "bash";
    }
    else {
      _msg =
        "Setting configuration format " +
        `'${_configuration_format}'.`;
    }
  }
  else {
    _msg =
      "Type of variable " +
      "'configuration format' must be string.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _configuration_format !== "bash" &&
       _configuration_format !== "json" ) {
    _msg =
      "Unknown configuration format " +
      `'${_configuration_format}'.`
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _configuration_format;
}

async function
  _network_check(
    _deployments,
    _contract,
    _target_network,
    _target_network_id) {
  let
    _contract_deployments_path,
    _error_flag,
    _evm_contract_deployment_networks,
    _evm_chains_info_args,
    _msg,
    _network_id;
  _msg =
    "Network check for deployments " +
    `'${_deployments}', contract '${_contract}', ` +
    `network '${_target_network}' and network with ID ` +
    `'${_target_network_id}'.`;
  _msg_info(
    _msg);
  _evm_contract_deployment_networks =
    _get(
      "_evm_contract",
      "deployment_networks");
  const
    _evm_contract_deployment_networks_type =
      typeof(
        _evm_contract_deployment_networks_dir);
  if ( _evm_contract_deployment_networks_type == "undefined" ||
       _evm_contract_deployment_networks == "" ) {
    const
      _libevm_contract_deployment_networks_module =
        await import(
          "./libevm-contract-deployment-networks");
      _evm_contract_deployment_networks =
        _libevm_contract_deployment_networks_module._evm_contract_deployment_networks;
  }
  _error_flag =
    false;
  _contract_deployments_path =
    _path_join( [
      _deployments,
      _contract ]);
  const
    _evm_contract_deployment_networks_args = [
      _contract_deployments_path,
      "y",                  // Display all
      "n",                  // Display safest
      "n"                   // Display cheapest
    ];
  const
    _networks =
      await _evm_contract_deployment_networks.apply(
        null,
        _evm_contract_deployment_networks_args);
  if ( _target_network_id != "" ) {
    if ( ! _networks.includes(
             _target_network_id) ) {
      _msg =
        "The contract does not result deployed on " +
        `network with id '${_target_network_id}'.`;
      _error_flag =
        true;
    }
  }
  else if ( _target_network != "" ) {
    if ( ! _networks.includes(
             _target_network) ) {
      _msg =
        "The contract does not result deployed on " +
        `network '${_target_network}'.`;
      _error_flag =
        true;
    }
  }
  else {
    _msg =
      "Provide one between a target network name " +
      "or ID.";
    _error_flag =
      true;
  }
  if ( _error_flag ) {
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _target_network_id == "" ) {
    _evm_chains_info_args = [
      "get",             // target command
      "name",            // input type
      "id",              // output type
      "offline",
      [ "system",        // db types
        "node" ],
      "kirsh",           // selection method, first
      "n",               // api keys
      "n",               // query all networks
      _target_network,
      []                 // database paths
    ];
    try {
      _network_id =
        await _evm_chains_info.apply(
          null,
          _evm_chains_info_args);
    }
    catch(
      _error) {
      _msg = 
        "Error while running '_evm_chains_info' " +
        `with arguments '${_evm_chains_info_args}'.`;
      _msg_error(
        _msg,
        0);
      _msg_error(
        _error,
        0);
      throw _error;
    }
  }
  else if ( _target_network == "" ) {
    _network_id =
      _target_network_id;
    _evm_chains_info_args = [
      "get",             // target command
      "id"  ,            // input type
      "name",            // output type
      "offline",
      [ "system",        // db types
        "node" ],
      "kirsh",           // selection method, first
      "n",               // api keys
      "n",               // query all networks
      _target_network_id,
      []                 // database paths
    ];
    try {
      _target_network =
        await _evm_chains_info.apply(
          null,
          _evm_chains_info_args);
    }
    catch(
      _error) {
      _msg = 
        "Error while running '_evm_chains_info' " +
        `with arguments '${_evm_chains_info_args}'.`;
      _msg_error(
        _msg,
        0);
      _msg_error(
        _error,
        0);
      throw _error;
    }
  }
  if ( _target_network_id != "" ) {
    if ( _target_network_id != _network_id ) {
      _msg =
        "Requested target network ID " +
        `'${_target_network_id}' does ` +
        `not correspond to '${_target_network}' ` +
        `known ID '${_network_id}'.`;
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  _msg =
    "Network check for deployments " +
    `'${_deployments}', contract '${_contract}', ` +
    `network '${_target_network}' and network with ID ` +
    `'${_target_network_id}' completed.`;
  _msg_info(
    _msg);
}

async function
  _user_deployments_init(
    _app,
    _deployments_dir) {
  let
    _evm_contract_deployments_dir;
  const
    _user_defined =
      "y";
  _evm_contract_deployments_dir =
    _get(
      "_evm_contract",
      "deployments_dir");
  const
    _evm_contract_deployments_dir_type =
      typeof(
        _evm_contract_deployments_dir);
  if ( _evm_contract_deployments_dir_type == "undefined" ||
       _evm_contract_deployments_dir == "" ) {
    const
      _libevm_contract_deployments_dir_module =
        await import(
          "./libevm-contract-deployments-dir");
      _evm_contract_deployments_dir =
        _libevm_contract_deployments_dir_module._evm_contract_deployments_dir;
  }
  const
    _evm_contract_deployments_dir_args = [
      _app,
      _user_defined
    ];
  const
    _system_deployments =
      await _evm_contract_deployments_dir.apply(
        null,
        _evm_contract_deployments_dir_args);
  _chmod(
    _deployments_dir,
    "0700");
  const
    _files =
      await _ls(
        _system_deployments);
  for ( _file of _files ) {
    _cp(
      _file,
      _deployments_dir);
  }
  return true;
}

