function
  _configuration_format_check(
    _configuration_format) {
  let
    _msg;
  const
    _configuration_format_type =
      typeof(
        _configuration_format);
  if ( _configuration_format_type === "undefined" ) {
    _msg =
      "Configuration format not set, " +
      "setting default (bash).";
    _msg_info(
      _msg);
    _configuration_format =
      "bash";
  }
  else if ( _configuration_format_type === "string" ) {
    if ( _configuration_format.length < 1 ) {
      _msg =
        "Configuration format not set, " +
        "setting default (bash).";
      _msg_info(
        _msg);
      _configuration_format =
        "bash";
    }
    else {
      _msg =
        "Setting configuration format " +
        `'${_configuration_format}'.`;
    }
  }
  else {
    _msg =
      "Type of variable " +
      "'configuration format' must be string.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _configuration_format !== "bash" &&
       _configuration_format !== "json" ) {
    _msg =
      "Unknown configuration format " +
      `'${_configuration_format}'.`
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _configuration_format;
}

async function
  _contract_abi_get(
    _network,
    _address,
    _api_key,
    _compiler_output,
    _abi,
    _app,
    _contract) {
  let
    _abi_target,
    _msg;
  const
    _abi_type =
      typeof(
        _abi);
  if ( _abi_type === "undefined" ) {
    _abi =
      _get(
        "contract",
        "abi");
    _msg =
      "Variable '_abi' not defined, " +
      "defaulting to global variable " +
      "'contract_abi', which has value " +
      `'${_abi}'.`;
    _msg_info(
      _msg);
  }
  const
    _network_type =
      typeof(
        _network);
  if ( _network_type === "undefined" ) {
    _network =
      _get(
        "target",
        "network");
    _msg =
      "Variable '_network' not defined, " +
      "defaulting to global variable " +
      "'target_network', which has value " +
      `'${_network}'.`;
    _msg_info(
      _msg);
  }
  const
    _api_key_type =
      typeof(
        _api_key);
  if ( _api_key_type == "undefined" ) {
    _api_key =
      _get(
        "api",
        "key");
    _msg =
      "Variable '_api_key' not defined, " +
      "defaulting to global variable " +
      "'api_key', which has value " +
      `'${_api_key}'.`;
    _msg_info(
      _msg);
  }
  const
    _compiler_output_type =
      typeof(
        _compiler_output);
  if ( _compiler_output_type == "undefined" ) {
    _compiler_output =
      _get(
        "contract",
        "compiler_output");
    _msg =
      "Variable '_compiler_output' not defined, " +
      "defaulting to global variable " +
      "'contract_compiler_output', which has value " +
      `'${_compiler_output}'.`;
    _msg_info(
      _msg);
  }
  _app =
    _app_check(
      _app);
  const
    _contract_type =
      typeof(
        _contract);
  if ( _contract_type == "undefined" ) {
    _contract =
      _get(
        "target",
        "contract");
    _msg =
      "Variable '_contract' not defined, " +
      "defaulting to global variable " +
      "'target_contract', which has value " +
      `'${_contract}'.`;
    _msg_info(
      _msg);
  }
  const
    _address_type =
      typeof(
        _address);
  if ( _address_type == "undefined" ) {
    _address =
      _get(
        "contract",
        "address");
    _msg =
      "Variable '_address' not defined, " +
      "defaulting to global variable " +
      "'contract_address', which has value " +
      `'${_address}'.`;
    _msg_info(
      _msg);
  }
  _abi_target =
    _abi;
  if ( typeof(
         _abi_target) === "undefined" ||
       _abi_target === "" ) {
    _abi_target =
      _default_artifact_path_get(
        "abi");
    if ( ! _file_exists(
             _abi_target) ) {
      if ( _app !== "" &&
           _contract !== "" ) {
        _msg =
          `Getting LibEVM app '${_app}' ` +
          `ABI for contract '${_contract}'.`;
        _msg_info(
          _msg);
        const
          _evm_contract_deployment_abi_args = [
            [ _network ] ,
            [ _network ],
            "n",
            _app,
            _contract,
            "",                     // version
            "n",                    // user level
            "json",                 // configuration format
            ""
          ];
        try {
          _abi =
            await _evm_contract_deployment_abi.apply(
              null,
              _evm_contract_deployment_abi_args);
        }
        catch(
          _error) {
          _msg =
            `Error retrieving LibEVM app '${_app}' ` +
            `ABI for contract '${_contract}'.`;
          _msg_error(
            _msg,
            0);
          throw _error;
        }
      }
    }
  }
  const
    _abi_dir =
      _dirname(
        _abi);
  if ( ! _file_exists(
           _abi) &&
       ! _file_exists(
           _compiler_output) ) {
    if ( _file_exists(
           _abi_target) ) {
      _abi =
        _abi_target;
    }
    else {
      _contract_artifacts_retrieve(
        _abi_dir);
    }
  }
  return _abi;
}

async function
  _network_check(
    _deployments_dir,
    _contract,
    _target_network,
    _target_network_id,
    _app,
    _user_defined) {
  let
    _contract_deployments_dir,
    _error_flag,
    _evm_contract_deployment_networks,
    _evm_chains_info_args,
    _msg,
    _network_id,
    _networks;
  _error_flag =
    false;
  _app =
    _app_check(
      _app,
      false);
  _user_defined =
    _user_defined_check(
      _user_defined);
  const
    _deployments_dir_check_args = [
      _deployments_dir,
      _app,
      _user_defined
    ];
  try {
    _deployments_dir =
      await _deployments_dir_check.apply(
        null,
        _deployments_dir_check_args);
  }
  catch(
    _error) {
    _msg =
      "Error checking '_deployments_dir' " +
      "variable in '_network_check' function:";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  _msg =
    "Network check for deployments " +
    `'${_deployments_dir}', contract '${_contract}', ` +
    `network '${_target_network}' and network with ID ` +
    `'${_target_network_id}'.`;
  _msg_info(
    _msg);
  _evm_contract_deployment_networks =
    _get(
      "_evm_contract_deployment",
      "networks");
  try {
    _evm_contract_deployment_networks =
      await _evm_contract_deployment_networks_check(
        _evm_contract_deployment_networks);
  }
  catch(
    _error) {
    _msg =
      "Error importing '_evm_contract_deployment_networks'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  _contract_deployments_dir =
    _path_join( [
      _deployments_dir,
      _contract ]);
  const
    _evm_contract_deployment_networks_args = [
      _contract_deployments_dir,
      "y",                  // Display all
      "n",                  // Display safest
      "n"                   // Display cheapest
    ];
  try {
    _networks =
      await _evm_contract_deployment_networks.apply(
        null,
        _evm_contract_deployment_networks_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_evm_contract_deployment_networks' " +
      `with parameters:`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _evm_contract_deployment_networks_args);
    _echo2(
      _error);
    throw _error;
  }
  if ( _target_network_id != "" ) {
    if ( ! _networks.includes(
             _target_network_id) ) {
      _msg =
        "The contract does not result deployed on " +
        `network with id '${_target_network_id}'.`;
      _error_flag =
        true;
    }
  }
  else if ( _target_network != "" ) {
    if ( ! _networks.includes(
             _target_network) ) {
      _msg =
        "The contract does not result deployed on " +
        `network '${_target_network}'.`;
      _error_flag =
        true;
    }
  }
  else {
    _msg =
      "Provide one between a target network name " +
      "or ID.";
    _error_flag =
      true;
  }
  if ( _error_flag ) {
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _target_network_id == "" ) {
    _evm_chains_info_args = [
      "get",             // target command
      "name",            // input type
      "id",              // output type
      "offline",
      [ "system",        // db types
        "node" ],
      "kirsh",           // selection method, first
      "n",               // api keys
      "n",               // query all networks
      _target_network,
      []                 // database paths
    ];
    try {
      _network_id =
        await _evm_chains_info.apply(
          null,
          _evm_chains_info_args);
    }
    catch(
      _error) {
      _msg = 
        "Error while running '_evm_chains_info' " +
        `with arguments '${_evm_chains_info_args}'.`;
      _msg_error(
        _msg,
        0);
      _msg_error(
        _error,
        0);
      throw _error;
    }
  }
  else if ( _target_network == "" ) {
    _network_id =
      _target_network_id;
    _evm_chains_info_args = [
      "get",             // target command
      "id"  ,            // input type
      "name",            // output type
      "offline",
      [ "system",        // db types
        "node" ],
      "kirsh",           // selection method, first
      "n",               // api keys
      "n",               // query all networks
      _target_network_id,
      []                 // database paths
    ];
    try {
      _target_network =
        await _evm_chains_info.apply(
          null,
          _evm_chains_info_args);
    }
    catch(
      _error) {
      _msg = 
        "Error while running '_evm_chains_info' " +
        `with arguments '${_evm_chains_info_args}'.`;
      _msg_error(
        _msg,
        0);
      _msg_error(
        _error,
        0);
      throw _error;
    }
  }
  if ( _target_network_id != "" ) {
    if ( _target_network_id != _network_id ) {
      _msg =
        "Requested target network ID " +
        `'${_target_network_id}' does ` +
        `not correspond to '${_target_network}' ` +
        `known ID '${_network_id}'.`;
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  _msg =
    "Network check for deployments " +
    `'${_deployments_dir}', contract '${_contract}', ` +
    `network '${_target_network}' and network with ID ` +
    `'${_target_network_id}' completed.`;
  _msg_info(
    _msg);
}

