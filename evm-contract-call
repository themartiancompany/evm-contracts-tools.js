async function 
  _overrides_set(
    _help_display) {
  _target_app_auto_detect();
  if ( ! _help_display &&
       typeof(_help_display) != "undefined" &&
       _help_display != "" ) {
    const
      _address_valid =
        _address_check(
          contract_address);
    if ( ! _address_valid ) {
      const
        _msg =
          "Contract address " +
          `'${contract_address}' is ` +
          `invalid.`;
      _msg_error(
        _msg,
        1);
    }
  }
  _override_set(
    "call",
    "date",
    _get_date_human());
  _override_set(
    "wallet",
    "name",
    "default");
  _override_set(
    "index",
    "retrieve",
    "n");
  _override_set(
    "retries",
    "max",
    "300");
  _override_set(
    "rpc",
    "selection",
    "kirsh");
  _override_set(
    "call",
    "type",
    "static");
  _call_auth_auto_detect();
  _override_set(
    "call",
    "timeout",
    "300000");
  _override_set(
    "measure",
    "unit",
    "ether");
  _override_set(
    "msg",
    "value",
    "0");
  // _api_key_auto_detect();
  if ( contract_address != "" ) {
    if ( contract_abi == "" ) {
      contract_abi =
        _default_artifact_path_get(
          "abi");
      _artifact_local_auto_detect(
        "bytecode");
      _artifact_local_auto_detect(
        "compiler_output");
      if ( contract_abi == "" ||
           _default_artifact_path_get(
             "abi") == contract_abi ) {
        _contract_abi_auto_detect();
      }
    }
  }
  await _wallet_overrides_set(
    "evm-wallet",
    wallet_name,
    call_auth);
}

