    _argv_url_get(
      "rpc_selection")[
        0]);
  const
    _target_networks =
      _get(
        "target",
        "networks");
  for ( _network of _argv_url_get(
                     "network") ) {
    _target_networks.push(
      _network);
  }
  _set(
    "target",
    "networks",
    _target_networks);
  const
    _method_args =
     _get(
       "method",
       "args");
  for ( _method of _argv_url_get(
                     "method_args") ) {
    _method_args.push(
      _method);
  }
  _set(
    "method",
    "args",
    _method_args);
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    _argv_url_get(
      "quiet");
  if ( _global[
         "quiet"].length === 0 ) {
    _global[
      "quiet"] =
      "n";
  }
}

async function
  _evm_contract_call_cmdline(
    _app_opts) {
  let
    _result;
  const
    _results =
      await _evm_contract_call.apply(
        null,
        app_opts);
  const
    _results_type =
      typeof(
        _results);
  if ( _results_type == "object" ) {
    for ( _result of _results ) {
      _echo(
        _result);
    }
  }
  else if ( _results_type == "string" ) {
    _printf(
      _results);
  }
}

