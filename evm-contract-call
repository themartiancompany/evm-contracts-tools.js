async function 
  _cmdline_parse() {
  let
    _help_display,
    _msg;
  const
    _argv_args = {
      "booleans": [
        "a",
        "auth",
        "h",
        "help",
        "I",
        "index-retrieve",
        "v",
        "verbose"
      ]
    };
  const
    _argv =
      await _argv_get(
        _argv_args);
  const
    _options =
      _argv[
        "_"];
  const
    _global =
      _global_get();
  _global[
    "quiet"] = 
    "y";
  _set(
    "runtime",
    "environment",
    "node");
  if ( _argv["h"] == true ) {
    _help_display =
      true;
  }
  if ( _argv["help"] == true ) {
    _help_display =
      true;
  }
  if ( ( _options.indexOf(
           "--help") > -1 ||
         _options.indexOf(
           "-h") > -1) ) {
    _help_display =
      true;
  }
  if ( _help_display ) {
    _global[
      "quiet"] = 
      "n";
    await _overrides_set(
      _help_display);
    _usage(
      0);
  }
  if ( typeof(
         _argv) == "undefined" ||
       _argv[
         "_"].length < 1 ) {
    _msg =
      "Contract address argument required.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  _set(
    "contract",
    "address",
    _argv[
      "_"][
        0]);
  if ( typeof(
         _argv) == "undefined" ||
       _argv[
         "_"].length < 2 ) {
    _msg =
      "Contract method argument required.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  _set(
    "contract",
    "method",
    _argv[
